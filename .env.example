# Yappy Comercial (Banco General) — V2 "Botón de Pago" credentials.
# Copy this file to .env.local and fill in real values there; .env.local is
# gitignored and is the only place real secrets should live.
YAPPY_API_KEY=
YAPPY_SECRET_KEY=
YAPPY_SECRET_SEED=
YAPPY_MERCHANT_ID=
YAPPY_MERCHANT_ALIAS=
YAPPY_BASE_URL=https://api-comecom-uat.yappycloud.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
